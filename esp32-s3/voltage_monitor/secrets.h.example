// secrets.h.example — copy to secrets.h (gitignored) and fill in.
//
// The four 35-bit Compustar patterns below are FOB-IDENTIFYING. They are
// the on-air bit patterns your specific 1WSHR-PRO FOB sends for each
// button, captured once via SDR (see sdr/06-framing-extraction.md and
// sdr/scripts/capture-to-secrets.py). Treat them like your car keys:
// anyone with these can command your starter. They live in secrets.h,
// which the repo .gitignore excludes — NEVER commit the filled-in file.
//
// Until you have real captures, leave this as-is and the firmware keeps
// RF transmit DISABLED (the all-zero placeholders are rejected as
// "not captured" so a bench board never transmits a bogus packet).
//
//   cp secrets.h.example secrets.h
//   # then paste your real 35-char patterns over the placeholders
//
// Each pattern is exactly 35 characters of '0'/'1'.

#pragma once

// ---- WiFi ----
// The network the board joins (STA). If it can't join, the firmware falls
// back to its own Access Point so the dashboard stays reachable.
#define SECRET_WIFI_SSID "your-wifi-ssid"
#define SECRET_WIFI_PASS "your-wifi-password"
// Fallback Access-Point password (8+ chars, or "" for an open AP).
#define SECRET_AP_PASS   "esp32volt"

// ---- Compustar captured patterns ----
// Set to 1 once you've pasted REAL captured patterns below. While this is
// 0, the firmware treats the patterns as placeholders and refuses to TX.
#define COMPUSTAR_PATTERNS_CAPTURED 0

#define COMPUSTAR_START  "00000000000000000000000000000000000"
#define COMPUSTAR_LOCK   "00000000000000000000000000000000000"
#define COMPUSTAR_UNLOCK "00000000000000000000000000000000000"
#define COMPUSTAR_TRUNK  "00000000000000000000000000000000000"

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.env
*.egg-info/

# MicroPython
*.mpy

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# SDR captures — these are huge (MBs to GBs per file)
*.bin
*.iq
*.complex
*.cfile
*.cu8
*.cs8
*.cs16
*.cf32
captures/
sdr/captures/*
!sdr/captures/.gitkeep
sdr/recordings/

# Logs (application logs only — NOT the daily journal at logs/YYYY-MM-DD.md)
*.log

# Build artifacts
build/
dist/
*.bin.firmware
firmware-*.bin

# Pi
.cache/
boot.log

# Secrets (don't commit keys, wifi passwords, MQTT creds, etc.)
secrets.py
secrets.json
secrets.h
**/secrets.h
config.local.*
*.key
keeloq_device_key.txt

# Arduino / arduino-cli build output (regenerable, large)
esp32-s3/**/build/
**/*.ino.bin
**/*.ino.elf
**/*.ino.map

# Per-FOB sensitive analysis: serial number, function-code mapping,
# captured hopping codes, counter values. The general framing.md is
# committed; *.local.md files in sdr/analysis are not.
sdr/analysis/framing.local.md
sdr/analysis/*.local.md
sdr/analysis/*.secret.md

# Runtime state written by the controller / simulator when COUNTER_FILE
# defaults to cwd (tests redirect to tmp, but stray runs leave it here)
compustar_counter.json
**/compustar_counter.json

# Local notes that shouldn't be public
TODO.local.md
notes.local.md
.scratch/

# History-scrub working directory — its replacements.txt and README
# contain the leaked values literally. Must never be committed.
tools/scrub-history/

# Context-preservation document for Claude sessions. Contains
# operational details and forward-looking project state that shouldn't
# be public. Always lives locally only.
braindump.md

# Raw chat transcripts written out for local reference. Conversation
# content (operational details, half-decided tradeoffs, etc.) — never
# committed.
chat.txt
chat-*.txt
CHAT.txt

# Image staging folder at the project root — raw drops (screenshots,
# phone photos) that get curated into logs/images/YYYY-MM-DD/ before
# committing. The folder itself is scratch; don't commit it.
/Pictures/

# Claude Code local settings + agent worktrees (not shared)
.claude/settings.local.json
.claude/worktrees/

# Auto-generated vault-context file (per-project Obsidian links); regenerated
# from the vault and shouldn't be tracked.
CLAUDE.md

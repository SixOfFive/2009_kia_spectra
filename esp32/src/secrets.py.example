"""
ESP32 secrets — copy this file to secrets.py (which is gitignored) and
fill in real values before deploying. DO NOT commit secrets.py.

The values here are PLACEHOLDERS so the type system is happy. Replace
each one.
"""

# ----- WiFi -----

WIFI_SSID = "your-home-wifi-ssid"
WIFI_PASSWORD = "your-wifi-password"


# ----- MQTT broker (optional — leave MQTT_BROKER = None to disable) -----

MQTT_BROKER = "192.168.1.10"       # IP or hostname of your broker
MQTT_PORT = 1883                    # 1883 = plain, 8883 = TLS
MQTT_USERNAME = "vroom"             # broker auth (None = anonymous)
MQTT_PASSWORD = "change-me"
MQTT_TOPIC_PREFIX = "vroom/spectra"  # all topics will be <prefix>/...


# ----- Compustar Keeloq (CRITICAL: derived from SDR captures of YOUR FOB) -----

# 64-bit device key for the specific FOB paired with the car's Compustar
# brain. Extract from the FOB's HCS chip EEPROM (via PICkit) or recover
# from SDR capture analysis (via manufacturer key + serial derivation).
COMPUSTAR_DEVICE_KEY = 0x0000000000000000  # PLACEHOLDER — replace

# 28-bit FOB serial number visible in the fixed-code portion of every
# transmission. Read it off the SDR-decoded packet bits.
COMPUSTAR_SERIAL = 0x0000000  # PLACEHOLDER — replace

# Current rolling-code counter. Must be at least one ahead of the last
# value the brain accepted. If the brain ever rejects our packets due
# to counter desync, you'll need to send two consecutive valid codes
# to re-synchronize.
# The ESP32 persists this to flash after every successful TX, so this
# value is just the *initial* counter on first boot.
COMPUSTAR_COUNTER = 0x0000  # set to one higher than the last FOB press

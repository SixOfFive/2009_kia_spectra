"""
ESP32 secrets — copy this file to secrets.py (which is gitignored) and
fill in real values before deploying. DO NOT commit secrets.py.

The values here are PLACEHOLDERS so the type system is happy. Replace
each one.
"""

# ----- WiFi -----

WIFI_SSID = "your-home-wifi-ssid"
WIFI_PASSWORD = "your-wifi-password"


# ----- MQTT broker (optional — leave MQTT_BROKER = None to disable) -----

MQTT_BROKER = "192.168.1.10"       # IP or hostname of your broker
MQTT_PORT = 1883                    # 1883 = plain, 8883 = TLS
MQTT_USERNAME = "vroom"             # broker auth (None = anonymous)
MQTT_PASSWORD = "change-me"
MQTT_TOPIC_PREFIX = "vroom/spectra"  # all topics will be <prefix>/...


# ----- Compustar 1WSHR-PRO captured packets (FIXED CODE — no key needed) -----
#
# The 1WSHR-PRO is a 1-way fixed-code FOB. There's no rolling counter
# and no encryption — same press = identical packet on the wire. To
# replicate any button you just capture its 35-bit pattern once via SDR
# and transmit it verbatim. See:
#   - sdr/06-framing-extraction.md       — how to extract patterns
#   - sdr/analysis/framing.md            — protocol details
#   - esp32/src/lib/compustar.py         — packet builder API

# 16-bit Remote ID (the FOB's serial). Cosmetic — used only for logging
# and the preflight sanity check; the actual on-air ID is embedded in
# the captured bit patterns below.
COMPUSTAR_REMOTE_ID = 0x0000  # PLACEHOLDER — replace (16-bit hex)

# Per-button captured bit patterns. Each value is a 35-character string
# of "0" and "1" (whitespace, "_", "-" are ignored for readability).
# Keys MUST be exactly: START, LOCK, UNLOCK, TRUNK.
COMPUSTAR_PACKETS = {
    "START":  "00000000000000000000000000000000000",  # 35 zeros PLACEHOLDER
    "LOCK":   "00000000000000000000000000000000000",
    "UNLOCK": "00000000000000000000000000000000000",
    "TRUNK":  "00000000000000000000000000000000000",
}

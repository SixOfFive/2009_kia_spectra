"""
Pi-side secrets — copy this file to secrets.py (which is gitignored)
and fill in real values. DO NOT commit secrets.py.

For most home installs the Pi can be configured for WiFi via raspi-config
instead, in which case WIFI_SSID / WIFI_PASSWORD here are unused.
"""

# ----- WiFi (only used if configuring WiFi from Python rather than wpa_supplicant) -----

WIFI_SSID = "your-home-wifi-ssid"
WIFI_PASSWORD = "your-wifi-password"


# ----- MQTT broker (leave MQTT_BROKER = None to disable MQTT entirely) -----

MQTT_BROKER = "192.168.1.10"
MQTT_PORT = 1883
MQTT_USERNAME = "vroom"
MQTT_PASSWORD = "change-me"
MQTT_TOPIC_PREFIX = "vroom/spectra"


# ----- SNMPv2c responder (read-only, vroom-only OIDs) -----
#
# Serves the OID tree under 1.3.6.1.4.1.99999.7. See docs/20-snmp-integration.md
# for the full OID reference + snmpwalk examples.
#
# Default port is 1161 (non-privileged — no Linux capabilities needed).
# To use the standard SNMP port 161, set SNMP_PORT = 161 AND uncomment the
# AmbientCapabilities lines in pi/systemd/vroom-snmp.service.
#
# Community is the SNMPv2c "password". Default "public" is fine for a LAN
# where the responder only exposes read-only telemetry; change it if the
# Pi is on a less trusted segment.

SNMP_COMMUNITY = "public"
SNMP_PORT = 1161
SNMP_BIND_HOST = "0.0.0.0"

"""
Pi-side secrets — copy this file to secrets.py (which is gitignored)
and fill in real values. DO NOT commit secrets.py.

For most home installs the Pi can be configured for WiFi via raspi-config
instead, in which case WIFI_SSID / WIFI_PASSWORD here are unused.
"""

# ----- WiFi (only used if configuring WiFi from Python rather than wpa_supplicant) -----

WIFI_SSID = "your-home-wifi-ssid"
WIFI_PASSWORD = "your-wifi-password"


# ----- MQTT broker (leave MQTT_BROKER = None to disable MQTT entirely) -----

MQTT_BROKER = "192.168.1.10"
MQTT_PORT = 1883
MQTT_USERNAME = "vroom"
MQTT_PASSWORD = "change-me"
MQTT_TOPIC_PREFIX = "vroom/spectra"
